      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"is_food\": {\n      \"type\": \"boolean\",\n      \"description\": \"사진에 음식이 있으면 true\"\n    },\n    \"meal_type\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"아침\",\n        \"점심\",\n        \"저녁\",\n        \"간식\"\n      ]\n    },\n    \"foods\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"food_name\": {\n            \"type\": \"string\",\n            \"description\": \"음식 이름 (한국어)\"\n          },\n          \"amount\": {\n            \"type\": \"string\",\n            \"description\": \"추정 분량, 예: 1공기(210g)\"\n          },\n          \"calories\": {\n            \"type\": \"number\",\n            \"description\": \"kcal\"\n          },\n          \"carbs_g\": {\n            \"type\": \"number\"\n          },\n          \"protein_g\": {\n            \"type\": \"number\"\n          },\n          \"fat_g\": {\n            \"type\": \"number\"\n          },\n          \"sodium_mg\": {\n            \"type\": \"number\"\n          },\n          \"confidence\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"높음\",\n              \"중간\",\n              \"낮음\"\n            ]\n          }\n        },\n        \"required\": [\n          \"food_name\",\n          \"amount\",\n          \"calories\",\n          \"carbs_g\",\n          \"protein_g\",\n          \"fat_g\",\n          \"sodium_mg\",\n          \"confidence\"\n        ]\n      }\n    },\n    \"summary\": {\n      \"type\": \"string\",\n      \"description\": \"한 줄 총평 (한국어, 60자 이내)\"\n    }\n  },\n  \"required\": [\n    \"is_food\",\n    \"meal_type\",\n    \"foods\",\n    \"summary\"\n  ]\n}"
      },
