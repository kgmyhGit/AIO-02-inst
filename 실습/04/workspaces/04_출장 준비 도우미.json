      ],
      "id": "87a6b163-3288-4283-8f4e-a59aad4b938f",
      "name": "city_lookup"
    },
    {
      "parameters": {
        "toolDescription": "위도와 경도로 오늘부터 16일 동안의 일별 예보를 가져온다.\n위도와 경도는 반드시 \"city_lookup\"이 돌려준 값을 넣는다.\n결과의 daily.time은 날짜 목록이고, 같은 순서로 precipitation_probability_max(강수 확률 %),\ntemperature_2m_max(최고 기온 °C), temperature_2m_min(최저 기온 °C)이 들어 있다.",
        "url": "=https://api.open-meteo.com/v1/forecast",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "latitude",
              "value": "={{ $fromAI('latitude', 'city_lookup 결과의 latitude', 'number') }}"
            },
            {
              "name": "longitude",
              "value": "={{ $fromAI('longitude', 'city_lookup 결과의 longitude', 'number') }}"
            },
            {
              "name": "daily",
              "value": "precipitation_probability_max,temperature_2m_max,temperature_2m_min"
            },
            {
              "name": "timezone",
              "value": "auto"
            },
            {
              "name": "forecast_days",
              "value": "16"
            }
          ]
        },
        "options": {}
      },
