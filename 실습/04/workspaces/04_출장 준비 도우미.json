    {
      "parameters": {
        "toolDescription": "도시 이름으로 위도, 경도, 나라, 시간대를 찾는다. 날씨 예보를 조회하기 전에 반드시 먼저 쓴다.\n결과의 results 배열에서 첫 번째 원소의 latitude, longitude를 쓴다.\nresults 필드가 없으면 그 이름의 도시를 찾지 못한 것이다.",
        "url": "https://geocoding-api.open-meteo.com/v1/search",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "name",
              "value": "={{ $fromAI('city_name', `위도, 경도를 조회할 도시의 이름\n예: 서울, 런던, 도쿄, Seoul`, 'string') }}"
            },
            {
              "name": "count",
              "value": "1"
            },
            {
