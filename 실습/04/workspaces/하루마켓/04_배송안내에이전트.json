    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"status\": {\n      \"type\": \"string\",\n      \"enum\": [\"answered\", \"needs_info\", \"handoff\"]\n    },\n    \"answer\": {\n      \"type\": [\"string\", \"null\"]\n    },\n    \"evidence\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"order_id\": { \"type\": \"string\" },\n          \"tool_status\": { \"type\": \"string\" },\n          \"order_status\": { \"type\": [\"string\", \"null\"] },\n          \"expected_from\": { \"type\": [\"string\", \"null\"] },\n          \"expected_to\": { \"type\": [\"string\", \"null\"] },\n          \"delay_check_required\": { \"type\": [\"boolean\", \"null\"] }\n        },\n        \"required\": [\"order_id\", \"tool_status\"]\n      }\n    }\n  },\n  \"required\": [\"status\", \"answer\", \"evidence\"]\n}"
      },
      "id": "7142c184-fd9e-5934-83c4-128cfbc2e5ff",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        500,
        260
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f0",
              "name": "r_status",
              "value": "={{ [\"answered\",\"needs_info\",\"handoff\"].includes($json.output.status) }}",
              "type": "boolean"
            },
            {
              "id": "f1",
              "name": "r_answer",
              "value": "={{ $json.output.status === \"handoff\" || (typeof $json.output.answer === \"string\" && $json.output.answer.trim() !== \"\") }}",
              "type": "boolean"
            },
            {
              "id": "f2",
              "name": "r_lookup",
              "value": "={{ $json.output.status === \"handoff\" || (Array.isArray($json.output.evidence) && $json.output.evidence.length > 0 && $json.output.evidence.every(e => e.tool_status === \"ok\" && e.delay_check_required !== true)) }}",
              "type": "boolean"
            },
            {
              "id": "f3",
              "name": "r_evidence",
              "value": "={{ Array.isArray($json.output.evidence) && $json.output.evidence.every(e => $('문의 입력').item.json.order_ids.includes(e.order_id)) && ($ifEmpty($json.output.answer, \"\").toUpperCase().match(/O-[0-9]{4}/g) || []).every(id => $json.output.evidence.some(e => e.order_id === id && e.tool_status === \"ok\")) }}",
              "type": "boolean"
            },
            {
              "id": "f4",
              "name": "r_handoff_answer",
              "value": "={{ !($json.output.status === \"handoff\" && Array.isArray($json.output.evidence) && $json.output.evidence.some(e => e.tool_status !== \"ok\") && $json.output.answer) }}",
              "type": "boolean"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
