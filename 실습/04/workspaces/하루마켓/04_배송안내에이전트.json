      "id": "b13a71fd-13eb-5fef-aabc-b9efba735a4f",
      "name": "order_lookup",
      "type": "@n8n/n8n-nodes-langchain.toolWorkflow",
      "typeVersion": 2.2,
      "position": [
        300,
