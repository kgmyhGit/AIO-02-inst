# 6장 실습용 환경 변수 예시
#
# 5장까지 쓰던 .env 파일을 그대로 쓰고, 아래 한 줄(MOCK_EXEC_KEY)을 더한다.
# 앞 장의 값(비밀번호, 암호화 키, 공개 주소, 조회 키)은 바꾸지 않는다.
# .env 파일은 다른 사람과 공유하지 않고 Git 저장소에 올리지 않는다.
#
# 값에 따옴표를 붙이지 않는다. 각 줄 끝에 공백을 남기지 않는다.

POSTGRES_USER=n8n
POSTGRES_PASSWORD=<3장에서-정한-비밀번호>
N8N_ENCRYPTION_KEY=<3장에서-만든-키>
TIMEZONE=Asia/Seoul

# 3장에서 받은 공개 주소. n8n은 이 값으로 메일의 응답 링크를 만든다.
# 링크를 열 때 ngrok 터널이 열려 있어야 한다. 끝의 빗금을 지우지 않는다.
N8N_WEBHOOK_URL=https://<3장에서-받은-개발-도메인>/

# 조회 전용 키. 4장에서 정한 값을 그대로 둔다.
# 이 키로 집행 엔드포인트를 부르면 모의 API가 403을 돌려준다. 실습 6-4에서 확인한다.
MOCK_API_KEY=<4장에서-정한-모의-API-키>

# --- 여기부터 6장에서 더하는 값이다 ---

# 집행 키. 환불과 교환 발송에만 쓴다.
# 조회 키와 반드시 다른 값이어야 한다. 같은 값이면 모의 API 컨테이너가 시작하지 않는다.
# 같은 값을 n8n의 Header Auth 자격 증명(하루마켓 집행 API)의 Value 칸에 넣는다.
MOCK_EXEC_KEY=<직접-정한-집행-키>

# --- .env에 넣지 않는 값 ---
#
# Gmail SMTP 정보(주소, 앱 비밀번호)는 n8n 화면에서 자격 증명으로 등록한다.
# 앱 비밀번호는 Gmail 로그인 비밀번호가 아니다. 2단계 인증을 켠 뒤 따로 발급한다.
# 발급 절차는 guides/Gmail_SMTP_준비.md에 있다.
#
# 실습에서 메일을 받는 주소는 워크플로우의 설정 노드에 넣는다.
# 고객 역할과 담당자 역할 모두 본인 주소를 쓴다. 실제로 메일이 나가므로 값을 다시 확인한다.
