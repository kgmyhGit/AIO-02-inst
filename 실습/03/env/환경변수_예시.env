# 3장 실습용 환경 변수 예시
#
# 이 파일을 같은 폴더에 .env 라는 이름으로 복사한 뒤 < > 로 표시한 자리표시자를 자기 값으로 바꾼다.
# .env 파일에는 실제 비밀번호와 키가 들어가므로 다른 사람과 공유하지 않고,
# Git 저장소에 올리지 않는다(10장에서 다시 다룬다).
#
# 값에 따옴표를 붙이지 않는다. 각 줄 끝에 공백을 남기지 않는다.

# PostgreSQL에 접속할 사용자 이름. 그대로 두어도 된다.
POSTGRES_USER=n8n

# PostgreSQL 비밀번호. 직접 정한다. 영문자와 숫자로만 만드는 편이 안전하다.
POSTGRES_PASSWORD=<직접-정한-비밀번호>

# 자격 증명을 암호화하는 키. 직접 만든다.
# 만드는 방법은 실습 3-1의 1단계에 있다. 한 번 정하면 바꾸지 않는다.
N8N_ENCRYPTION_KEY=<직접-만든-키>

# 시간대. 이 교재는 한국 시간을 기준으로 한다.
TIMEZONE=Asia/Seoul

# 외부 서비스가 n8n을 호출할 공개 HTTPS 주소. ngrok이 보여 준 주소를 적고 끝에 /를 붙인다.
# 주소를 받는 방법은 실습 3-1의 '시작 전' 절차에 있다.
# ngrok을 쓸 수 없으면 http://localhost:5678/ 로 둔다. 이 경우 외부 서비스는 n8n을 호출할 수 없다.
N8N_WEBHOOK_URL=https://<내-개발-도메인>/
