    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"status\": {\n      \"type\": \"string\",\n      \"enum\": [\"answered\", \"needs_info\", \"handoff\"]\n    },\n    \"answer\": {\n      \"type\": [\"string\", \"null\"]\n    },\n    \"evidence\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"doc_id\": { \"type\": \"string\" },\n          \"version\": { \"type\": \"string\" }\n        },\n        \"required\": [\"doc_id\", \"version\"]\n      }\n    }\n  },\n  \"required\": [\"status\", \"answer\", \"evidence\"]\n}"
      },
      "id": "308d69f7-3903-4307-afa2-c943a0419123",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        592,
        464
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f37",
              "name": "search_calls",
              "value": "={{ ($json.intermediateSteps || [])\n  .filter(s => s.action && s.action.tool === \"policy_search\")\n  .map(s => [].concat(typeof s.observation === \"string\" ? JSON.parse(s.observation) : s.observation)[0])\n  .map(r => ({\n    query: r.evidence ? r.evidence.query : null,\n    status: r.status,\n    index_version: r.evidence ? r.evidence.index_version : null,\n    score_threshold: r.evidence ? r.evidence.score_threshold : null,\n    docs: (r.answer || []).map(c => ({ doc_id: c.doc_id, version: String(c.version), title: c.title, score: c.score }))\n  })) }}",
              "type": "array"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "914cb623-643f-43fe-92bc-7b737bbad87b",
      "name": "검색 근거 모으기",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        672,
        112
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f38",
              "name": "r_status",
              "value": "={{ [\"answered\",\"needs_info\",\"handoff\"].includes($json.output.status) }}",
              "type": "boolean"
            },
            {
              "id": "f39",
              "name": "r_evidence_format",
              "value": "={{ Array.isArray($json.output.evidence) && $json.output.evidence.every(e => /^[A-Z]{3}-[0-9]{2}$/.test(e.doc_id) && String($ifEmpty(e.version, \"\")) !== \"\") }}",
              "type": "boolean"
            },
            {
              "id": "f40",
              "name": "r_answer",
              "value": "={{ $json.output.status === \"handoff\" ? $json.output.answer === null : (typeof $json.output.answer === \"string\" && $json.output.answer.trim() !== \"\") }}",
              "type": "boolean"
            },
            {
              "id": "f41",
              "name": "r_has_evidence",
              "value": "={{ $json.output.status !== \"answered\" || (Array.isArray($json.output.evidence) && $json.output.evidence.length > 0) }}",
              "type": "boolean"
            },
            {
              "id": "f42",
              "name": "r_cited_in_search",
              "value": "={{ Array.isArray($json.output.evidence) && $json.output.evidence.every(e => $json.search_calls.some(c => c.status === \"ok\" && c.docs.some(d => d.doc_id === e.doc_id && d.version === String(e.version)))) }}",
              "type": "boolean"
            },
            {
              "id": "f43",
              "name": "r_ids_in_answer",
              "value": "={{ ($ifEmpty($json.output.answer, \"\").match(/[A-Z]{3}-[0-9]{2}/g) || []).every(id => Array.isArray($json.output.evidence) && $json.output.evidence.some(e => e.doc_id === id)) }}",
              "type": "boolean"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
