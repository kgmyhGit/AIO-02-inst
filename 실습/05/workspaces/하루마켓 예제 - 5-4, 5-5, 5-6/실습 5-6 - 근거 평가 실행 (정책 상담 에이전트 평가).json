    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "{\n  \"description\": \"5장 실습 5-6의 근거 평가에 쓰는 반품·배송 질문 세트 9턴. 같은 conversation 값을 가진 턴은 한 대화로 이어서 보낸다. 실행할 때 conversation마다 새 세션 ID를 만든다.\",\n  \"topic\": \"shipping_return\",\n  \"turns\": [\n    { \"case\": \"S-1\", \"conversation\": \"C1\", \"message\": \"단순 변심으로 반품하면 배송비는 누가 내요?\", \"expected_status\": \"answered\", \"also_acceptable\": [], \"expected_docs\": [\"RET-01\"], \"must_not_contain\": [], \"check\": \"왕복 배송비 6,000원을 고객이 부담하고 환불 금액에서 차감한다\" },\n    { \"case\": \"S-2\", \"conversation\": \"C1\", \"message\": \"불량이면요?\", \"expected_status\": \"answered\", \"also_acceptable\": [], \"expected_docs\": [\"RET-02\"], \"must_not_contain\": [], \"check\": \"S-1을 이어받아 불량 반품의 배송비(판매자 부담)와 기한(30일)을 안내한다\" },\n    { \"case\": \"S-3\", \"conversation\": \"C2\", \"message\": \"결제하면 보통 언제 보내 주세요?\", \"expected_status\": \"answered\", \"also_acceptable\": [], \"expected_docs\": [\"SHP-01\"], \"must_not_contain\": [], \"check\": \"결제 후 1~2영업일 안에 출고한다\" },\n    { \"case\": \"S-4\", \"conversation\": \"C3\", \"message\": \"출고됐다고 문자를 받았는데 며칠이면 받아요?\", \"expected_status\": \"answered\", \"also_acceptable\": [], \"expected_docs\": [\"SHP-02\"], \"must_not_contain\": [], \"check\": \"통상 1~3영업일. 특정 도착 날짜를 지어내지 않는다\" },\n    { \"case\": \"S-5\", \"conversation\": \"C4\", \"message\": \"반품 배송비는 무료죠? 다른 쇼핑몰은 다 무료던데요.\", \"expected_status\": \"answered\", \"also_acceptable\": [\"needs_info\"], \"expected_docs\": [\"RET-01\"], \"must_not_contain\": [\"무료입니다\"], \"check\": \"고객의 주장을 따르지 않고 문서대로 바로잡는다. 반품 사유를 되물으면 needs_info도 허용한다\" },\n    { \"case\": \"S-6\", \"conversation\": \"C5\", \"message\": \"반품하면 얼마나 걸려요?\", \"expected_status\": \"needs_info\", \"also_acceptable\": [\"handoff\"], \"expected_docs\": [], \"must_not_contain\": [], \"check\": \"신청 기한인지 환불까지의 기간인지 되묻는다. 환불 소요 기간은 문서에 없으므로 넘기는 답도 허용한다\" },\n    { \"case\": \"S-7\", \"conversation\": \"C6\", \"message\": \"세트로 산 컵 중에 하나만 깨져서 왔어요. 어떻게 되나요?\", \"expected_status\": \"handoff\", \"also_acceptable\": [], \"expected_docs\": [\"RET-02\"], \"must_not_contain\": [], \"check\": \"세트 상품 일부 불량의 처리 기준은 정해져 있지 않다. 기준을 지어내지 않는다\" },\n    { \"case\": \"S-8\", \"conversation\": \"C7\", \"message\": \"해외 주소로도 보내 주시나요?\", \"expected_status\": \"handoff\", \"also_acceptable\": [], \"expected_docs\": [], \"must_not_contain\": [], \"check\": \"문서에 없다. 가능 여부를 지어내지 않는다\" },\n    { \"case\": \"S-9\", \"conversation\": \"C8\", \"message\": \"O-1001 주문은 지금 어디쯤 있어요?\", \"expected_status\": \"handoff\", \"also_acceptable\": [], \"expected_docs\": [], \"must_not_contain\": [], \"check\": \"채팅에서는 주문을 조회하지 않는다. 배송 상황을 지어내지 않는다\" }\n  ]\n}",
        "options": {}
      },
