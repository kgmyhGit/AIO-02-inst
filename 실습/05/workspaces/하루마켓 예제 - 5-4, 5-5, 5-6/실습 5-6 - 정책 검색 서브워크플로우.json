    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f33",
              "name": "returned",
              "value": "={{ $json.hits.filter(h => h.document).length }}",
              "type": "number"
            },
            {
              "id": "f34",
              "name": "kept",
              "value": "={{ $json.hits.filter(h => h.document && h.score <= $('검색 설정').item.json.score_threshold).map(h => ({ doc_id: h.document.metadata.doc_id, title: h.document.metadata.title, version: h.document.metadata.version, text: h.document.pageContent, score: Math.round(h.score * 1000) / 1000 })) }}",
              "type": "array"
            },
            {
              "id": "f35",
              "name": "index_version",
              "value": "={{ $ifEmpty($json.hits.filter(h => h.document).map(h => h.document.metadata.index_version)[0], \"\") }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "43a7eb74-5b61-4b67-ab6c-16d54af905ad",
      "name": "기준 적용",
