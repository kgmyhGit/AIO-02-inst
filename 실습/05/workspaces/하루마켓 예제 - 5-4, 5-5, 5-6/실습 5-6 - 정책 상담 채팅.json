            },
            {
              "id": "f48",
              "name": "final_status",
              "value": "={{ ($json.status === \"needs_info\" && $('세션 기록').item.json.needs_info_count + 1 > 2) ? \"handoff\" : $json.status }}",
              "type": "string"
            },
            {
              "id": "f49",
              "name": "handoff_reason",
              "value": "={{ !$json.validation.passed\n  ? ($json.validation.failed_rules.includes(\"output_format\") ? \"output_format\" : \"validation_failed\")\n  : ($json.status === \"needs_info\" && $('세션 기록').item.json.needs_info_count + 1 > 2)\n    ? \"info_limit\"\n    : $json.status !== \"handoff\"\n      ? \"\"\n      : $json.search_calls.some(c => c.status === \"search_error\")\n        ? \"search_error\"\n        : ($json.search_calls.length > 0 && $json.search_calls.every(c => c.status === \"no_match\"))\n          ? \"no_evidence\"\n          : \"agent_handoff\" }}",
              "type": "string"
            }
