        "query": "UPDATE chat_sessions\nSET needs_info_count = $2,\n    status          = CASE WHEN $3 = 'handoff' THEN 'handed_off' ELSE status END,\n    handoff_reason  = CASE WHEN $3 = 'handoff' THEN $4 ELSE handoff_reason END,\n    handed_off_at   = CASE WHEN $3 = 'handoff' THEN now() ELSE handed_off_at END\nWHERE session_id = $1\nRETURNING session_id, status;",
        "options": {
          "queryReplacement": "={{ [ $('채팅 받기').item.json.sessionId, $json.needs_info_count, $json.final_status, $json.handoff_reason ] }}"
