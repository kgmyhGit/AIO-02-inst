# 4장 실습용 환경 변수 예시
#
# 3장에서 만든 .env 파일을 그대로 쓰고, 맨 아래 MOCK_API_KEY 한 줄만 더한다.
# 3장의 값(비밀번호, 암호화 키)은 바꾸지 않는다. 암호화 키가 바뀌면 저장한 자격 증명을 열 수 없다.
# .env 파일은 다른 사람과 공유하지 않고 Git 저장소에 올리지 않는다.
#
# 값에 따옴표를 붙이지 않는다. 각 줄 끝에 공백을 남기지 않는다.

POSTGRES_USER=n8n
POSTGRES_PASSWORD=1111
N8N_ENCRYPTION_KEY=Mhv+ZkAwOyMvgiuvlXGKyxLlZr8xaBsdasmKO7RGsks=
TIMEZONE=Asia/Seoul
N8N_WEBHOOK_URL=https://reply-reacquire-humbly.ngrok-free.dev

# 모의 주문 API의 키. 영문자와 숫자로 직접 정한다.
# 같은 값을 n8n의 Header Auth 자격 증명(하루마켓 주문 API)의 Value 칸에 넣는다.
# Mac: openssl rand -base64 32
# Win: 파워쉘 - [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
#     안되면 - $b = New-Object byte[] 32; $rng = [Security.Cryptography.RandomNumberGenerator]::Create(); $rng.GetBytes($b); $rng.Dispose(); [Convert]::ToBase64String($b)
MOCK_API_KEY=pUAefn7YhCarTnE6Dmguo/d5yJCrdXF8jxyEcoLl2hA=
