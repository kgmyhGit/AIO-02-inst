      "position": [
        1168,
        2144
      ]
    },
    {
      "parameters": {
        "description": "세미나 예산을 계산한다. attendees(인원, 정수), snack_level(basic, standard, lunch 중 하나), handouts(인쇄물 여부, true 또는 false)를 받는다.",
        "jsCode": "// 가상의 사내 단가다. 계산은 모델이 아니라 이 코드가 한다. 결과는 글자 하나로 돌려준다.\nconst PRICE = { basic: 5000, standard: 9000, lunch: 13000 };\nconst HANDOUT = 500;\nconst n = Number(query.attendees);\nif (!Number.isInteger(n) || n <= 0) {\n  return JSON.stringify({ status: 'invalid_input', reason: 'attendees는 1 이상의 정수여야 한다' });\n}\nif (!(query.snack_level in PRICE)) {\n  return JSON.stringify({ status: 'invalid_input', reason: 'snack_level은 basic, standard, lunch 중 하나여야 한다' });\n}\nconst snack = PRICE[query.snack_level] * n;\nconst handouts = query.handouts === true ? HANDOUT * n : 0;\nreturn JSON.stringify({ status: 'ok', attendees: n, snack_level: query.snack_level,\n  snack_total: snack, handout_total: handouts, total: snack + handouts });\n",
        "specifyInputSchema": true,
        "jsonSchemaExample": "{ \"attendees\": 10, \"snack_level\": \"basic\", \"handouts\": false }"
      },
      "id": "a05bf048-2f18-4f88-b0b8-00b7ad6e13bb",
