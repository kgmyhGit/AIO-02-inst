    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"needs_clarification\": {\n      \"type\": \"boolean\"\n    },\n    \"question\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"summary\": {\n      \"type\": \"string\"\n    },\n    \"notice_draft\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    }\n  },\n  \"required\": [\n    \"needs_clarification\",\n    \"question\",\n    \"summary\",\n    \"notice_draft\"\n  ]\n}"
      },
      "id": "44b82f05-0e90-4bd9-b34a-b933f420cf76",
      "name": "감독 출력 형식",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1696,
        1824
      ]
    },
    {
      "parameters": {
        "jsCode": "// 감독이 어떤 담당을 어떤 입력으로 어떤 순서로 불렀는지 정리한다.\nconst j = $input.first().json;\nconst steps = Array.isArray(j.intermediateSteps) ? j.intermediateSteps : [];\nconst calls = steps.map((s, i) => ({ // object, index (0부터)\n  order: i + 1,\n  tool: s.action ? s.action.tool : null, // 사용한 tool\n  input: s.action ? s.action.toolInput : null, // tool 입력\n  result: typeof s.observation === 'string' ? s.observation.slice(0, 300) : s.observation // tool 응답값 (300자만)\n}));\nconst failed = j.error !== undefined;\nconst message = failed ? String((j.error && j.error.message) || j.error) : null; //error 메세지\nconst out = failed ? {} : (j.output || {}); // 정상응답. out에는 error이면 {}, 아니면 item의 output\nreturn [{ json: {\n  end_reason: failed ? (message.startsWith('Max iterations') ? 'limit_reached' : 'delegation_failed')\n                     : (out.needs_clarification ? 'needs_info' : 'completed'),\n  roles: calls.map(c => c.tool),\n  calls,\n  model_calls_estimate: calls.length + 1,\n  summary: out.summary ?? null,\n  notice_draft: failed ? null : (out.notice_draft ?? null),\n  error: message\n} }];\n"
      },
