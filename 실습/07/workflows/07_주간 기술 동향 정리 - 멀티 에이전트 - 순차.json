    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"report\": { \"type\": \"string\" },\n    \"citations\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } \n  }\n  },\n   \n  \"required\": [\"report\", \"citations\"]\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1184,
        -112
      ],
      "id": "a273d01e-d12f-4556-b26c-319ff156d1aa",
      "name": "Structured Output Parser1"
    },
    {
      "parameters": {
        "jsCode": "// 보고서의 인용을 규칙으로 검사한다. 넘어오지 않은 정보는 이 검사로 찾을 수 없다(실습 5단계).\nconst j = $input.first().json;                                        // 앞 노드가 낸 결과 한 건을 가져온다\nconst out = j.output || j;                                            // 에이전트 결과가 output 안에 있든 밖에 있든 같게 읽는다\nconst report = String(out.report || '');                              // 검사 대상인 보고서 본문\nconst citations = Array.isArray(out.citations) ? out.citations : [];  // 모델이 인용했다고 적어 낸 글 번호 목록\nconst research = $('조사 결과 검사').isExecuted ? $('조사 결과 검사').first().json.research : null;  // 나눈 구성이면 조사 결과를, 단일 구성이면 null을 쓴다\nconst allowed = research\n  ? research.topics.flatMap(t => t.posts.map(p => p.post_id))         // 나눈 구성: 조사 역할이 고른 글만 인용할 수 있다\n  : $('목록 만들기').first().json.all_ids;                              // 단일 구성: 이번 주 글 목록 전체가 인용 대상이다\nconst inReport = [...new Set(report.match(/P-[0-9]{2}/g) || [])];     // 보고서 문장에 실제로 적힌 글 번호\nconst rules = {\n  r_cited_allowed: citations.every(id => allowed.includes(id)),       // 인용 대상 밖의 글 번호를 지어내지 않았는가\n  r_report_ids_cited: inReport.every(id => citations.includes(id))    // 보고서에 쓴 글 번호가 citations에도 빠짐없이 있는가\n};\nconst failed = Object.keys(rules).filter(k => !rules[k]);             // 어긴 규칙의 이름을 모은다\nreturn [{ json: { passed: failed.length === 0, failed_rules: failed, report, citations } }];  // 두 규칙을 모두 지켰는지와 어긴 규칙을 넘긴다"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1296,
        -320
