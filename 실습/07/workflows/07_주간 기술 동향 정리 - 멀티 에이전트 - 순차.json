      ],
      "id": "8bb8d1a1-c2a6-44a9-bd66-78ce17700439",
      "name": "get_post_body"
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"status\": { \"type\": \"string\", \"enum\": [\"ok\", \"needs_info\"] },\n    \"topics\": { \"type\": \"array\", \"items\": { \"type\": \"object\", \"properties\": {\n      \"topic\": { \"type\": \"string\" },\n      \"posts\": { \"type\": \"array\", \"items\": { \"type\": \"object\", \"properties\": {\n        \"post_id\": { \"type\": \"string\" },\n        \"facts\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } } }, \"required\": [\"post_id\", \"facts\"] } } },\n      \"required\": [\"topic\", \"posts\"] } },\n    \"excluded\": { \"type\": \"array\", \"items\": { \"type\": \"object\", \"properties\": {\n      \"post_id\": { \"type\": \"string\" }, \"reason\": { \"type\": \"string\" } }, \"required\": [\"post_id\", \"reason\"] } }\n  },\n  \"required\": [\"status\", \"topics\", \"excluded\"]\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        512,
        112
      ],
      "id": "8b6b5208-f82b-4981-a3ff-03c2e5f6a1c1",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "jsCode": "// 넘기기 전에 조사 결과를 역할 계약으로 검사한다. 통과한 조사 결과만 research 필드로 넘긴다.\nconst j = $input.first().json;\nconst ids = $('목록 만들기').first().json.all_ids;\nconst out = j.output || {};\nconst topics = Array.isArray(out.topics) ? out.topics : [];\nconst picked = topics.flatMap(t => (t.posts || []).map(p => p.post_id));\n// status 가 ok, needs_info 중 하나인지\n// 참조한 id들이 실제 디비에 있는 id들인지\n// 모든 조회결과에 fact 항목이 있는지\n// report(보고서) 항목이 있는지? (없어야 한다.)\nconst rules = {\n  r_status: ['ok', 'needs_info'].includes(out.status),\n  r_ids_exist: picked.every(id => ids.includes(id)),\n  r_has_facts: topics.every(t => (t.posts || []).every(p => Array.isArray(p.facts) && p.facts.length > 0)),\n  r_no_report: out.report === undefined\n};\nconst failed = Object.keys(rules).filter(k => !rules[k]);\nconst passed = failed.length === 0 && out.status === 'ok';\nconst end_reason = failed.length > 0 ? 'delegation_failed' : (out.status === 'ok' ? null : 'needs_info');\nconst steps = Array.isArray(j.intermediateSteps) ? j.intermediateSteps : [];\nreturn [{ json: { passed, end_reason, failed_rules: failed,\n  research: { topics, excluded: out.excluded || [] },\n  body_reads: steps.filter(s => s.action && s.action.tool === 'get_post_body').map(s => s.action.toolInput) } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        -80
      ],
      "id": "eab35d5e-ca44-488e-8609-0d8cb997e6bf",
      "name": "조사 결과 검사"
    },
