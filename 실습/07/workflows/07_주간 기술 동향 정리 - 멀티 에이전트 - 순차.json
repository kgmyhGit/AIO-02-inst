    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "글 번호(post_id)로 글 본문(body)를 가져온다. 요약이 짧거나 모호해서 무슨 뉴스인지 알 수 없을 때 사용한다.",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "value": "LSHTKYYnIoZwEGqe",
          "mode": "list",
          "cachedResultName": "tech_posts",
          "cachedResultUrl": "/projects/v7pUrkzpSuSJCp9z/datatables/LSHTKYYnIoZwEGqe"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "post_id",
              "keyValue": "={{ $fromAI('post_id', `본문을 읽을 글의 id(post_id). \"P-\" 뒤에 숫자 두 자리로 구성. (예: P-01, P-12)`, 'string') }}"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.dataTableTool",
      "typeVersion": 1.1,
      "position": [
        336,
